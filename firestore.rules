rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roomMember(roomId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.playerUids;
    }

    match /playtests/{gameId} {
      // `firebaseUid` is the Firebase Auth anonymous uid FirebasePlaytestRepository
      // writes on every playtest doc — the only field these rules can verify
      // against request.auth.uid. `testerId` is a separate, persisted
      // per-device id (see services/external_test_profile.dart) that is NOT
      // tied to Firebase Auth, so it must never be used for access control.
      allow create: if signedIn() && request.resource.data.firebaseUid == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.firebaseUid == request.auth.uid;
      match /actions/{actionId} {
        allow create, read: if signedIn()
          && get(/databases/$(database)/documents/playtests/$(gameId)).data.firebaseUid == request.auth.uid;
      }
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.playerUids == [request.auth.uid];
      allow get: if signedIn();
      allow list: if false;
      allow update: if signedIn()
        && (
          (request.auth.uid in resource.data.playerUids
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt', 'currentTurnUid',
                'revision', 'winner', 'finishedAt']))
          || (resource.data.status == 'waiting'
            && resource.data.guestUid == null
            && request.resource.data.guestUid == request.auth.uid)
            && request.resource.data.hostUid == resource.data.hostUid
            && request.resource.data.playerUids
              == [resource.data.hostUid, request.auth.uid]
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['guestUid', 'status', 'updatedAt', 'playerUids'])
        );
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      match /players/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid;
      }

      match /actions/{actionId} {
        allow read: if roomMember(roomId);
        allow create: if roomMember(roomId)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'actorUid', 'actionIndex', 'actionType', 'targetPersonId',
            'createdAt', 'clientRevision'
          ]);
      }
    }
  }
}
