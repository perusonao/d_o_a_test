rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roomMember(roomId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.playerUids;
    }
    // Admin dashboard (read-only): a user is admin iff they are signed in
    // (via Firebase Auth Google Sign-In on the admin screen — never the
    // anonymous auth regular players use) AND admins/{uid} exists AND its
    // enabled field is true. Deliberately NOT based on comparing an email
    // address — see lib/features/nine_judges/admin/.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /playtests/{gameId} {
      // `firebaseUid` is the Firebase Auth anonymous uid FirebasePlaytestRepository
      // writes on every playtest doc — the only field these rules can verify
      // against request.auth.uid. `testerId` is a separate, persisted
      // per-device id (see services/external_test_profile.dart) that is NOT
      // tied to Firebase Auth, so it must never be used for access control.
      allow create: if signedIn() && request.resource.data.firebaseUid == request.auth.uid;
      // Owner can always read their own log; an admin (see isAdmin() above)
      // may read any log for external-test analysis. update/delete stay
      // owner-only — no client, including admin, may modify or remove a
      // submitted playtest in this initial admin-dashboard version.
      allow read: if signedIn()
        && (resource.data.firebaseUid == request.auth.uid || isAdmin());
      allow update, delete: if signedIn() && resource.data.firebaseUid == request.auth.uid;
      match /actions/{actionId} {
        allow create: if signedIn()
          && get(/databases/$(database)/documents/playtests/$(gameId)).data.firebaseUid == request.auth.uid;
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/playtests/$(gameId)).data.firebaseUid == request.auth.uid
            || isAdmin());
      }
    }

    match /tutorialCompletions/{uid} {
      // One doc per Firebase Auth uid (see
      // services/tutorial_completion_repository.dart): a durable,
      // cross-device count of users who completed the tutorial, independent
      // of whether they ever submitted a playtest. Same owner-or-admin
      // pattern as `playtests` above; `testerId` here is informational only
      // (never used for access control, same rule as `playtests`).
      allow create, update: if signedIn() && uid == request.auth.uid;
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow delete: if false;
    }

    match /appStats/{statId} {
      // AppStatsRepository's raw, never-deduplicated traffic counters
      // ("appStats/visits", "appStats/plays") — a single `count` field, only
      // ever moved by exactly +1 per write, and touching no other field.
      // `create` handles the very first visit/play ever recorded (count
      // must start at exactly 1); `update` covers every one after that
      // (the new count must be exactly the previous value + 1). This is the
      // one collection any signed-in (including anonymous) client may
      // increment, since recording a visit/play must work before any
      // human/admin interaction — but it can never be set/reset to an
      // arbitrary value, only ever bumped by one.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow read: if signedIn() && isAdmin();
      allow delete: if false;
    }

    match /admins/{uid} {
      // No client may create/update/delete admin docs from this app — the
      // initial admin dashboard is read-only and has no "add/remove admin"
      // feature (section 20). The first admin doc must be created manually
      // in the Firebase Console (see README).
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.playerUids == [request.auth.uid];
      allow get: if signedIn();
      allow list: if false;
      allow update: if signedIn()
        && (
          (request.auth.uid in resource.data.playerUids
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt', 'currentTurnUid',
                'revision', 'winner', 'finishedAt']))
          || (resource.data.status == 'waiting'
            && resource.data.guestUid == null
            && request.resource.data.guestUid == request.auth.uid)
            && request.resource.data.hostUid == resource.data.hostUid
            && request.resource.data.playerUids
              == [resource.data.hostUid, request.auth.uid]
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['guestUid', 'status', 'updatedAt', 'playerUids'])
        );
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      match /players/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid;
      }

      match /actions/{actionId} {
        allow read: if roomMember(roomId);
        allow create: if roomMember(roomId)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'actorUid', 'actionIndex', 'actionType', 'targetPersonId',
            'createdAt', 'clientRevision'
          ]);
      }
    }
  }
}
